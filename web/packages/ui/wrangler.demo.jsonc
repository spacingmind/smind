{
  // ADR-0051 option (a): the web demo as a static-assets-only Cloudflare Worker on app.spacingmind.com.
  // Deployed by .github/workflows/demo-deploy.yml from `dist-demo` (`bun run build:demo`). There is no Worker script:
  // Cloudflare serves the files, and applies dist-demo/_headers (the CSP, frame-ancestors, nosniff, Referrer-Policy,
  // Permissions-Policy, caching) to every response, the SPA fallback included.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "smind-demo",
  "compatibility_date": "2026-10-01",
  // The demo is reachable only on its own domain, never on <name>.<account>.workers.dev or a preview URL.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-demo",
    // Unknown paths answer index.html (the app routes with the URL hash, so this only matters for a hand-typed path).
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "app.spacingmind.com", "custom_domain": true }],
  "observability": { "enabled": false }
}
