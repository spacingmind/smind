{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "owner": "spacing-mind",
    "version": "1.0.0",
    "scheme": "smind",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spacingmind.smind"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.spacingmind.smind"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "expo-status-bar",
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "smind attaches photos you choose to your prompts.",
          "cameraPermission": false
        }
      ],
      "expo-document-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "7184c9e3-0a46-44b5-befd-5a29f7f47675"
      }
    }
  }
}
