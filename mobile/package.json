{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@expo/ui": "~58.0.21",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "expo": "~58.0.16",
    "expo-crypto": "~58.0.7",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "~19.3.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "vitest run --exclude \"**/*.node.test.ts\"",
    "test:integration": "NODE_TLS_REJECT_UNAUTHORIZED=0 SMIND_REQUIRE_PASSWORD_HARNESS=1 vitest run src/relay/__tests__/integration.node.test.ts src/relay/__tests__/integration.persistent.node.test.ts src/relay/__tests__/integration.devices.node.test.ts src/relay/__tests__/integration.password.node.test.ts src/relay/__tests__/integration.queue.node.test.ts src/relay/__tests__/integration.stop.node.test.ts src/relay/__tests__/integration.replay.node.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke:web": "node scripts/smoke-web.mjs",
    "smoke:web:full": "node scripts/smoke-web.mjs --full"
  },
  "private": true
}
