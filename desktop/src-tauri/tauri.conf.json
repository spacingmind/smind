{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sMind",
  "version": "0.15.0",
  "identifier": "dev.spacingmind.desktop",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": {
      "script": "bun install && bun run --filter @smind/ui build:desktop",
      "cwd": "../../web"
    },
    "beforeDevCommand": {
      "script": "bun install && bun run --filter @smind/ui build:desktop",
      "cwd": "../../web"
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwRjgxQzdFOThCNUJGRjQKUldUMHY3V1lmaHo0NEFPTDAxTkdrTjlZbUV6cjFaVDJTRHpmb3ZVTURrakJmdmgyTEZKQmkreDEK",
      "endpoints": [
        "https://github.com/spacingmind/smind/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "smind"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
