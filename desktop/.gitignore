node_modules/
daemon-client/target/
src-tauri/target/
# gen/schemas/ is intentionally committed (see 2c9a511): tauri-cli reads
# it for capability validation without requiring a build first.
src-tauri/permissions/autogenerated/

# The desktop-flavored web UI build (AC1): built by beforeBuildCommand/
# beforeDevCommand before rust-embed embeds it; kept out of git like
# internal/server/dist, but the directory itself must exist so
# `cargo build`/`cargo test` succeed (an empty embed) with no prior web
# build.
ui/app/*
!ui/app/.gitkeep
