# Every text file is LF in the working tree on every OS. Tests read repo files
# (Dockerfile, docs/CLI reference, embedded prompts, JSON vectors) and compare or
# regex them with "\n"; a Windows checkout with core.autocrlf=true turned them
# into CRLF and failed those tests on the Windows full suite. Binaries are
# auto-detected and left alone; the per-path entries below stay as documentation.
* text=auto eol=lf

# Shell scripts must stay LF even on Windows checkouts (core.autocrlf=true):
# Git Bash on windows-latest CI and Windows dev machines run them directly.
*.sh text eol=lf

# Byte-compared by TestHelloVectorMatchesFile (and read by the mobile tests): a
# Windows checkout with core.autocrlf=true would turn the LF into CRLF.
internal/relay/devices/testdata/** text eol=lf

# Verified byte for byte (a minisign signature over checksums.txt): CRLF would
# make TestVerifyAcceptsRealTauriSignerOutput reject a genuine signature.
internal/selfupdate/testdata/** text eol=lf

# Embedded into the binary (go:embed bundle): a Windows checkout with
# core.autocrlf=true would otherwise ship SKILL.md files with CRLF endings.
internal/skills/bundle/** text eol=lf

# Golden files compared byte for byte by the service tests.
internal/service/testdata/** text eol=lf
